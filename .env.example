# ==============================================================================
# ಶ್ರೀ ಶನೀಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ (ರಿ) • Shree Shanishwara Swamy Temple (R.)
# Environment Variables Template — ಶ್ರೀ ಕ್ಷೇತ್ರ ಸಿದ್ದಗಿರಿ
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and update the values with your actual configuration.
# WARNING: NEVER commit actual secrets, API keys, or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Connection string for MongoDB (Local instance or MongoDB Atlas cluster)
MONGODB_URL=mongodb://localhost:27017
# Database name for the temple application
DB_NAME=shree_temple

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Strong random secret key used to sign JSON Web Tokens.
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
# Hashing algorithm for JWT (default: HS256)
JWT_ALGORITHM=HS256
# Access token expiration time in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
# Razorpay API Credentials (obtain from https://dashboard.razorpay.com/#/access/api-keys)
# For local testing, use 'rzp_test_...' credentials.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# ------------------------------------------------------------------------------
# YouPI-PG 0% Fee Self-Hosted UPI Gateway
# ------------------------------------------------------------------------------
YOUPI_PAYMENT_API_URL=https://api-pay.yourbrand.com
YOUPI_CHECKOUT_URL=https://pay.yourbrand.com
YOUPI_MERCHANT_ID=your_youpi_merchant_uuid_here
YOUPI_WEBHOOK_SECRET=your_youpi_webhook_secret_here
YOUPI_PUBLIC_KEY=your_youpi_public_key_here

# ------------------------------------------------------------------------------
# Initial System Administrator Credentials
# ------------------------------------------------------------------------------
# Default admin account auto-seeded on first database initialization
ADMIN_EMAIL=admin@shreeshani.com
ADMIN_PASSWORD=Admin@123_ChangeInProduction

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME=Shree Shanishwara Swamy Temple
# Environment mode: 'development', 'staging', or 'production'
APP_ENV=development
