# ==============================================================================
# Shree Shanishwara Swamy Temple Website — Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production before running Docker Compose:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# IMPORTANT SECURITY RULES:
#   1. NEVER commit your actual .env.production file to version control.
#   2. Use strong, randomly generated passwords and secrets.
#   3. Replace all placeholders before launching in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Networking Configuration
# ------------------------------------------------------------------------------
# Your registered domain (without http/https).
# Caddy will automatically generate and maintain Let's Encrypt SSL certificates for this domain.
# If testing on a server without a domain yet, you can set your server IP or 'localhost'.
DOMAIN=shreeshanitemple.com

# ------------------------------------------------------------------------------
# 2. Production Database Credentials (MongoDB)
# ------------------------------------------------------------------------------
# Choose a strong admin username and generate a random 32-character password:
# Generate password: openssl rand -base64 24
MONGO_ROOT_USER=temple_db_admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_32_CHARS
DB_NAME=shree_temple

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character hex secret:
# In terminal run: openssl rand -hex 32
JWT_SECRET_KEY=GENERATE_RANDOM_SECRET_USING_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay Live Mode)
# ------------------------------------------------------------------------------
# Obtain from your Razorpay Dashboard -> Settings -> API Keys (Live Mode)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id_here
RAZORPAY_KEY_SECRET=your_actual_live_key_secret_here

# ------------------------------------------------------------------------------
# 5. Production Administrator Credentials
# ------------------------------------------------------------------------------
# These credentials will be used for the initial super-admin account.
# Ensure the password is at least 14 characters with uppercase, lowercase, numbers, and symbols.
ADMIN_EMAIL=admin@shreeshanitemple.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_VERY_STRONG_ADMIN_PASSWORD!

# ------------------------------------------------------------------------------
# 6. Application Environment & Hardening
# ------------------------------------------------------------------------------
APP_NAME=Shree Shanishwara Swamy Temple
APP_ENV=production

# Comma-separated list of allowed origins for CORS (strictly match your domain)
ALLOWED_ORIGINS=https://shreeshanitemple.com,https://www.shreeshanitemple.com

# Disable public API Swagger/ReDoc schemas in production (set to true only for temporary debugging)
ENABLE_DOCS=false

