# ==============================================================================
# ಶ್ರೀ ಶನೀಶ್ವರಸ್ವಾಮಿ ದೇವಸ್ಥಾನ (ರಿ) • Shree Shanishwara Swamy Temple (R.)
# Backend Environment Variables Template — ಶ್ರೀ ಕ್ಷೇತ್ರ ಸಿದ್ದಗಿರಿ
# ==============================================================================
# Copy this file to '.env' in this directory and fill in actual credentials.
# WARNING: NEVER commit actual keys or secrets to version control.
# ==============================================================================

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=shree_temple

# Security & Authentication (JWT)
JWT_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# Cashfree Payment Gateway Integration
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Initial Admin Credentials
ADMIN_EMAIL=admin@shreeshani.com
ADMIN_PASSWORD=Admin@123_ChangeInProduction

# Application Environment
APP_NAME=Shree Shanishwara Swamy Temple
APP_ENV=development
